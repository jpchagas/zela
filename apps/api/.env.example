# Copy to .env for local development. Never commit real secrets.
ENV=development
DATABASE_URL=postgresql+psycopg://zela:zela@localhost:5433/zela
TEST_DATABASE_URL=postgresql+psycopg://zela:zela@localhost:5433/zela_test

# "firebase" verifies Firebase ID tokens. "dev" accepts `Bearer dev:<email>` and is
# refused outside ENV=development.
AUTH_MODE=dev
FIREBASE_PROJECT_ID=

CORS_ORIGINS=http://localhost:3000

# WhatsApp (Meta Cloud API). In deployed envs these come from Secret Manager.
WHATSAPP_VERIFY_TOKEN=local-verify-token
WHATSAPP_APP_SECRET=local-app-secret
WHATSAPP_SENDER=log
WHATSAPP_ACCESS_TOKEN=

SECRET_KEY=dev-insecure-secret-key

# anthropic (needs ANTHROPIC_API_KEY) or scripted (canned replies, no API calls)
LLM_PROVIDER=scripted
LLM_MODEL=claude-haiku-5-5
LLM_EFFORT=medium
# ANTHROPIC_API_KEY=

# Uploaded documents: local disk in development, Cloud Storage (pip install '.[gcp]') in production
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=.data/uploads
# STORAGE_BUCKET=
